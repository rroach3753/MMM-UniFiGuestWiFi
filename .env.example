# Server-only data source policy
UNIFI_GUEST_WIFI_AUTH_MODE=config
UNIFI_GUEST_WIFI_SITE=default
UNIFI_GUEST_WIFI_VERIFY_SSL=true

# Sensitive values are never broadcast unless explicitly allowed here.
UNIFI_GUEST_WIFI_ALLOW_WIFI_PASSWORD=false
UNIFI_GUEST_WIFI_ALLOW_VOUCHERS=false
UNIFI_GUEST_WIFI_ALLOW_HOTSPOT_PASSWORD=false

# Required when AUTH_MODE is api or auto.
UNIFI_GUEST_WIFI_URL=https://unifi.local
UNIFI_GUEST_WIFI_API_KEY=
UNIFI_GUEST_WIFI_USERNAME=
UNIFI_GUEST_WIFI_PASSWORD=
UNIFI_GUEST_WIFI_API_KEY_HEADER=X-API-Key
